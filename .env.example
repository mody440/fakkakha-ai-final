# Server-side only — set these in Vercel's dashboard, never commit real values.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Safe to expose to the browser (Supabase anon key is designed to be public;
# Row Level Security policies are what actually protect the data).
# These two are read by public/index.html — fill them in there too.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# SERVER-SIDE ONLY — as sensitive as GEMINI_API_KEY. Used by
# lib/supabaseAdmin.js to read/write exam_questions (which holds correct
# answers) without those answers ever reaching the browser. Find it in
# Supabase: Settings -> API -> "service_role" secret key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OPTIONAL — leave both blank to use the built-in Supabase-based rate
# limiter (works out of the box, zero extra setup). Set both to switch
# rate limiting to Upstash Redis instead (faster, purpose-built): create a
# free database at https://upstash.com and copy its REST URL + token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret protecting GET /api/metrics — pick any long random string.
# Without this set, /api/metrics always returns 401.
ADMIN_METRICS_KEY=

# Optional per-task model overrides (see lib/models.js). Leave blank to use
# defaults use a current stable fast model for classification and a stronger model for teaching
# everything else) — verify current model names in Google AI Studio first.
GEMINI_MODEL_FAST=
GEMINI_MODEL_SMART=

# Optional error monitoring
SENTRY_DSN=

# Optional but required for live web research. Keep server-side only.
# The endpoint must be HTTPS and return {web:{results:[]}} or {results:[]}.
SEARCH_PROVIDER_URL=
SEARCH_PROVIDER_API_KEY=
